# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Pinecone (schema-based index with integrated embedding, created on Day 9)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=advanced-rag-document-qa
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=documents

# Embeddings (generated by Pinecone, not locally)
EMBEDDING_PROVIDER=pinecone
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024
EMBEDDING_METRIC=cosine
EMBEDDING_TRUNCATE=END
EMBEDDING_BATCH_SIZE=64

# Retrieval (Day 11)
TOP_K=5
DENSE_TOP_K=20
KEYWORD_TOP_K=20
HYBRID_TOP_K=20
FINAL_TOP_K=5
RRF_K=60
RERANK_MODEL=bge-reranker-v2-m3
RERANK_MIN_SCORE=0.05
CHUNKING_STRATEGY=recursive

# Chunking / upload
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=20

# Day 10: Celery, PostgreSQL, uploads
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_db
UPLOAD_DIR=./uploads
# read by docker-compose for the postgres service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db
