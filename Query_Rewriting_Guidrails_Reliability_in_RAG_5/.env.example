# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Pinecone (schema-based index with integrated embedding, created on Day 9)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=advanced-rag-document-qa
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=documents

# Embeddings (generated by Pinecone, not locally)
EMBEDDING_PROVIDER=pinecone
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024
EMBEDDING_METRIC=cosine
EMBEDDING_TRUNCATE=END
EMBEDDING_BATCH_SIZE=64

# Retrieval (Day 11)
TOP_K=5
DENSE_TOP_K=20
KEYWORD_TOP_K=20
HYBRID_TOP_K=20
FINAL_TOP_K=5
RRF_K=60
RERANK_MODEL=bge-reranker-v2-m3
RERANK_MIN_SCORE=0.05
CHUNKING_STRATEGY=recursive

# Query rewriting + multi-query retrieval (helps vague questions)
# false = old single-query pipeline (can still be forced per request with "rewrite_query": true)
QUERY_REWRITE_ENABLED=true
# rewritten queries per question (1-5); the original question is always searched too
MULTI_QUERY_COUNT=3
# empty = use GEMINI_MODEL
QUERY_REWRITE_MODEL=
# a slow rewrite falls back to the original query after this many seconds
QUERY_REWRITE_TIMEOUT_S=8
# RRF weight of the user's own wording vs. each rewrite (1.0 = equal)
ORIGINAL_QUERY_WEIGHT=1.5

# LLM resilience: retries, timeouts, fallback model, usage logging
# model(s) tried when the primary still fails after its retries (comma-separated chain; empty = no fallback)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# retries per model after the first try (delay before retry n = LLM_RETRY_BACKOFF_S * 2**n, capped, with jitter)
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=1.0
LLM_RETRY_BACKOFF_MAX_S=8.0
# seconds per attempt (blocking / streaming) and for ALL attempts + backoff + fallback of one call
LLM_TIMEOUT_S=30
LLM_STREAM_TIMEOUT_S=60
LLM_TOTAL_TIMEOUT_S=90
# also write one row per Gemini call into the llm_usage table (logging to the app log is always on)
LLM_USAGE_PERSIST=true

# Guardrails (PII redaction, prompt-injection checks, output validation)
PII_REDACTION_ENABLED=true
# also redact PII found inside retrieved chunks before they are sent to Gemini
REDACT_CONTEXT=false
# comma-separated subset: email,phone,credit_card,aadhaar,pan,ssn,ip_address,api_key (empty = all)
PII_TYPES=
INJECTION_CHECK_ENABLED=true
# block = reject the question | flag = answer anyway and report it | off
INJECTION_ACTION=block
INJECTION_THRESHOLD=5
# poisoned retrieved chunks: drop | neutralize | off
CONTEXT_INJECTION_ACTION=drop
OUTPUT_VALIDATION_ENABLED=true
MAX_ANSWER_CHARS=6000

# Chunking / upload
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=20

# Day 10: Celery, PostgreSQL, uploads
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_db
UPLOAD_DIR=./uploads
# read by docker-compose for the postgres service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db
